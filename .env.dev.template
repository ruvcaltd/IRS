# ════════════════════════════════════════════════════════════════
# DEV ENVIRONMENT CONFIGURATION
# ════════════════════════════════════════════════════════════════
# Used by docker-compose.dev-vps.yml on the VPS.
# Place the populated version at /IRS-dev/.env on the VPS.
# NEVER commit actual credentials — this file is a template only.
#
# IMPORTANT: VPS_DOMAIN must match the dev subdomain exactly so
# the dotnet-api CORS policy accepts requests from the Angular UI.
# DB_NAME must point at the dev database (not the production one).

# ─── Domain ───────────────────────────────────
VPS_DOMAIN=irs-dev.ruvca-investments.com

# ─── SQL Server ───────────────────────────────
# Shares the production SQL Server container via host bridge.
# Uses a SEPARATE database — do NOT set this to IRS.
SA_PASSWORD=ChangeMeToStrongPassword123!
DB_NAME=IRS_Dev

# ─── JWT Authentication ───────────────────────
# Can share the same JWT config as production, or use separate values.
# CHANGE THIS: Min 32 chars, cryptographically random
# Generate with: openssl rand -base64 32
JWT_SECRET_KEY=ChangeMe_GenerateNewSecretKeyWith32CharactersMinimum1234
JWT_ISSUER=IRS.Api
JWT_AUDIENCE=IRS.Client

# ─── Third-Party API Keys ─────────────────────
OPENFIGI_API_KEY=ChangeMe_GenerateNewKeyFromOpenFigi
LLM_ENCRYPTION_KEY=ChangeMe_GenerateNewWith_openssl_rand_base64_32
ENCRYPTION_KEY=ChangeMe_GenerateNewWith_openssl_rand_base64_32
ENCRYPTION_IV=ChangeMe_GenerateNewInitializationVector

# ─── Flask API ────────────────────────────────
Yahoo_Fin_user=ChangeMe
Yahoo_fin_secret=ChangeMe
SECRET_KEY=ChangeMe_GenerateNewWith_openssl_rand_base64_32
BRAVE_API_TOKEN=ChangeMe
BRAVE_GOGGLES_URL=ChangeMe
